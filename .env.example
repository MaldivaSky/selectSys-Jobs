# ═══════════════════════════════════════════════════════════════════════════
# SELECTSYS JOBS — VARIÁVEIS DE AMBIENTE (ENV)
# ═══════════════════════════════════════════════════════════════════════════

# Ambiente de Execução
NODE_ENV=production

# URLs Públicas do Frontend (Vite exige prefixo VITE_)
VITE_APP_URL=https://selectsys-jobs.vercel.app
VITE_API_URL=https://selectsys-jobs.vercel.app/api

# Autenticação Google OAuth 2.0 & Auth.js Secret
VITE_GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com
AUTH_SECRET=selectsys-jobs-super-secret-key-32-chars-minimum

# Banco de Dados PostgreSQL 16 com RLS (Supabase, Neon ou Hetzner)
DATABASE_URL=postgresql://postgres:sua_senha@seu_host:5432/selectsys_jobs

# Cloudflare R2 Document Storage (Uploads da Ficha FUJIARTE)
R2_ACCOUNT_ID=sua-conta-cloudflare-r2
R2_ACCESS_KEY_ID=sua-chave-de-acesso-r2
R2_SECRET_ACCESS_KEY=sua-chave-secreta-r2
R2_BUCKET_NAME=selectsys-documents

# Anthropic Claude API (Parsing Inteligente de Currículos em PT/JA)
ANTHROPIC_API_KEY=sk-ant-api03-sua-chave-anthropic
