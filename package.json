    "cpu": [
      "current",
      "x64",
      "arm64"
    ]
  },
  "workspaces": [
    "app",
    "packages/*"
  ],
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "exceljs": "^4.4.0"
  }
}
